# Default to NVIDIA NIM. Configure NVIDIA_API_KEY and NVIDIA_MODEL before use.
VISION_PROVIDER=nvidia
OLLAMA_HOST=http://127.0.0.1:11434
# Set to an installed vision model. No model is silently selected/downloaded.
OLLAMA_MODEL=
OLLAMA_MODEL_VERSION=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_MODEL_VERSION=
NVIDIA_OUTPUT_MODE=prompt
# Optional for models that support it (e.g. GLM-5.3-Flash): low, high, max.
# Empty preserves the provider default. Benchmark before changing production.
NVIDIA_REASONING_EFFORT=
NVIDIA_MAX_IMAGE_BYTES=5000000
# Optional Google AI Studio / Gemini. Select gemini in the UI or VISION_PROVIDER.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_VERSION=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MAX_IMAGE_BYTES=10000000
PROVIDER_TIMEOUT_SECONDS=180
MODEL_MAX_TOKENS=4096
MODEL_CONTEXT_LENGTH=8192
PROMPT_VERSION=nameplate_identity_v002
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=60000000
IMAGE_MAX_EDGE=2560
IMAGE_CONTRAST=1.0
IMAGE_SHARPNESS=1.0
DATA_DIR=data
DATASET_DIR=datasets
PROFILES_FILE=config/profiles.toml
# Use this Mac's Tailscale IP for phone access. Local development uses loopback.
APP_HOST=127.0.0.1
APP_PORT=50003
# For router forwarding: APP_HOST=0.0.0.0, set a strong access password and your DDNS hostname.
ACCESS_PASSWORD=
TRUSTED_HOSTS=localhost,127.0.0.1
DEBUG_DATA=false
SECRET_KEY=
# Reserved for future calibrated decision models; enum confidence never uses these.
HIGH_CONFIDENCE_THRESHOLD=0.95
LOW_CONFIDENCE_THRESHOLD=0.80
REGRESSION_MAX_DROP=0.0
REGRESSION_MIN_KNOWN_SAMPLES=5
